# ---------------------------------------------------------------------------
# Kivi semantic memory - environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. Google Gemini API key (https://aistudio.google.com/apikey).
# This is the only credential the system needs.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Models. Defaults are chosen to keep the full 500-record pipeline inside a
# free-tier quota. Override if you have paid quota and want better quality.
# ---------------------------------------------------------------------------

# Cheap, high-volume work: per-record memory extraction during ingest.
KIVI_GEN_MODEL=gemini-3.5-flash-lite

# Lower-volume, higher-stakes work: Hey Kivi answering and tool selection.
KIVI_GEN_MODEL_HEAVY=gemini-3.5-flash

# Embeddings for hybrid retrieval.
KIVI_EMBED_MODEL=gemini-embedding-001
KIVI_EMBED_DIM=768

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

KIVI_DB_PATH=./data/kivi.db

# ---------------------------------------------------------------------------
# Cost and quota control
# ---------------------------------------------------------------------------

# Cache model responses and embeddings on disk, keyed by content hash.
# Strongly recommended: makes re-running the evaluation nearly free and
# makes results reproducible.
KIVI_LLM_CACHE=true

# Replay mode. When true, the system serves only from cache and raises on a
# cache miss instead of calling the API. Used to re-run an evaluation with
# zero API spend and byte-identical results.
KIVI_OFFLINE=false

# Refuse to start a new API call after this many in a single day, per model.
# A guard against silently burning a free-tier quota. 0 disables the guard.
KIVI_DAILY_CALL_LIMIT=0

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

KIVI_REQUEST_TIMEOUT=60
KIVI_MAX_RETRIES=4
KIVI_LOG_LEVEL=INFO
